<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" styleClass="scroll-container" stylesheets="@../styles/modern_theme.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.procurement.frontend.controller.DashboardController">

    <VBox spacing="24.0">
        <padding>
            <Insets top="10" right="10" bottom="20" left="10"/>
        </padding>

        <GridPane hgap="16" vgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
            </columnConstraints>
            
            <VBox styleClass="stat-card" GridPane.columnIndex="0">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="📑" styleClass="card-icon"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Live Aggregate" styleClass="card-badge, badge-blue"/>
                </HBox>
                <Label text="Total Requests" styleClass="card-title"/>
                <Label fx:id="lblTotalRequests" text="0" styleClass="card-value"/>
            </VBox>

            <VBox styleClass="stat-card" GridPane.columnIndex="1">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="⏳" styleClass="card-icon"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Action Required" styleClass="card-badge, badge-orange"/>
                </HBox>
                <Label text="Pending Approvals" styleClass="card-title"/>
                <Label fx:id="lblPendingApprovals" text="0" styleClass="card-value"/>
            </VBox>

            <VBox fx:id="cardExpenditure" styleClass="stat-card" GridPane.columnIndex="2">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="💳" styleClass="card-icon"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Verified Store Bills" styleClass="card-badge, badge-green"/>
                </HBox>
                <Label text="Total Expenditure" styleClass="card-title"/>
                <Label fx:id="lblTotalExpenditure" text="0.00" styleClass="card-value"/>
            </VBox>

            <VBox fx:id="cardLowStock" styleClass="stat-card" GridPane.columnIndex="3">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="⚠️" styleClass="card-icon"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblStockBadge" text="Optimal" styleClass="card-badge, badge-red"/>
                </HBox>
                <Label text="Low Stock Items" styleClass="card-title"/>
                <Label fx:id="lblLowStockItems" text="0" styleClass="card-value"/>
            </VBox>
        </GridPane>

        <HBox spacing="24">
            <VBox spacing="24" HBox.hgrow="ALWAYS">
                <VBox styleClass="section-card" spacing="12">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT">
                        <VBox>
                            <Label text="Request Velocity" styleClass="section-title"/>
                            <Label text="Real-time daily procurement request submission volume" styleClass="section-subtitle"/>
                        </VBox>
                    </HBox>
                    <AreaChart fx:id="velocityChart" prefHeight="260" createSymbols="false" horizontalGridLinesVisible="true" verticalGridLinesVisible="false">
                        <xAxis>
                            <CategoryAxis label="Days"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Requests"/>
                        </yAxis>
                    </AreaChart>
                </VBox>
            </VBox>

            <VBox fx:id="aiPanel" prefWidth="300" spacing="16" styleClass="ai-recommendation-panel">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="✨" styleClass="ai-spark-icon"/>
                    <VBox>
                        <Label text="ProcureFlow AI" styleClass="ai-title"/>
                        <Label text="Predictive inventory suggestions" styleClass="ai-subtitle"/>
                    </VBox>
                </HBox>
                <Separator/>
                <ScrollPane fitToWidth="true" prefHeight="350" styleClass="ai-scroll">
                    <Label fx:id="lblAIInsights" text="Analyzing current stock metrics to generate procurement strategy..." wrapText="true" styleClass="ai-text"/>
                </ScrollPane>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
