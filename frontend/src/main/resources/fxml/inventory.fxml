<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" styleClass="scroll-container" stylesheets="@../styles/modern_theme.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.procurement.frontend.controller.InventoryController">

    <VBox spacing="20.0">
        <padding>
            <Insets top="10" right="10" bottom="20" left="10"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox>
                <Label text="Central Inventory" styleClass="section-title"/>
                <Label text="Monitor, distribute, and replenish organizational assets" styleClass="section-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnNewItem" text="➕  Add New Item" onAction="#handleNewItem" styleClass="btn-primary"/>
        </HBox>

        <HBox spacing="20" alignment="TOP_LEFT">
            <!-- Left Side: Table & Search -->
            <VBox spacing="16" HBox.hgrow="ALWAYS">
                <!-- Filters / Search -->
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="search-bar-container">
                    <TextField fx:id="txtSearch" promptText="🔍 Search by SKU or Name..." prefWidth="250" styleClass="search-field"/>
                    <ComboBox fx:id="cmbCategoryFilter" promptText="Filter Category" prefWidth="150" styleClass="custom-combo"/>
                    <ComboBox fx:id="cmbStockFilter" promptText="Stock Level" prefWidth="150" styleClass="custom-combo"/>
                </HBox>

                <!-- Inventory Table -->
                <TableView fx:id="tblInventory" prefHeight="480" styleClass="custom-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSKU" text="SKU" prefWidth="110"/>
                        <TableColumn fx:id="colName" text="Item Name" prefWidth="220"/>
                        <TableColumn fx:id="colCategory" text="Category" prefWidth="130"/>
                        <TableColumn fx:id="colQuantity" text="Quantity" prefWidth="90"/>
                        <TableColumn fx:id="colUnit" text="Unit" prefWidth="80"/>
                        <TableColumn fx:id="colThreshold" text="Threshold" prefWidth="90"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                        <TableColumn fx:id="colAction" text="Actions" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right Side: Action Form (Add Item) -->
            <VBox fx:id="formPane" prefWidth="300" spacing="16" styleClass="ai-recommendation-panel" visible="false" managed="false">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Label text="Add New Inventory Item" styleClass="ai-title"/>
                <Separator/>
                
                <Label text="Item Name" styleClass="form-label"/>
                <TextField fx:id="txtItemName" promptText="e.g. Marker Pens" styleClass="form-field"/>

                <Label text="Category" styleClass="form-label"/>
                <ComboBox fx:id="cmbCategory" promptText="Select Category" maxWidth="Infinity" styleClass="custom-combo"/>

                <Label text="SKU Code" styleClass="form-label"/>
                <TextField fx:id="txtSKU" promptText="e.g. ST-MRK-PEN" styleClass="form-field"/>

                <Label text="Initial Quantity" styleClass="form-label"/>
                <TextField fx:id="txtQuantity" promptText="e.g. 100" styleClass="form-field"/>

                <Label text="Unit of Measure" styleClass="form-label"/>
                <TextField fx:id="txtUnit" promptText="e.g. boxes / units" styleClass="form-field"/>

                <Label text="Low Stock Alert Threshold" styleClass="form-label"/>
                <TextField fx:id="txtThreshold" promptText="e.g. 10" styleClass="form-field"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Cancel" onAction="#handleCancelForm" styleClass="btn-secondary"/>
                    <Button text="Save Item" onAction="#handleSubmitForm" styleClass="btn-primary"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
